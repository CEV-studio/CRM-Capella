# ================================================================
#  CAPELLA CRM — VARIABLES D'ENVIRONNEMENT
# ================================================================
#  Copie ce fichier en « .env.local » (même dossier) et colle
#  les valeurs récupérées dans les services concernés.
#
#  ⚠️  .env.local ne doit JAMAIS être partagé ni envoyé sur GitHub.
# ================================================================

# Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Project Settings > API > Project API keys > anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase > Project Settings > API > Project API keys > service_role
# Clé SECRÈTE : elle contourne toutes les protections. Jamais dans le navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Secret dédié au webhook Google Form -> CRM.
FORM_WEBHOOK_SECRET=

# Youtrust — conservé pour une éventuelle réactivation future.
YOUTRUST_API_KEY=
YOUTRUST_TEMPLATE_ID=
YOUTRUST_ENV=production

# ================================================================
# Gmail / Google Workspace
# ================================================================
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Activer Gmail API et ajouter l'URI de redirection :
# https://TON-DOMAINE-CRM/api/gmail/callback
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=

# Secret interne utilisé pour chiffrer le refresh token Gmail en base.
# Utiliser une valeur aléatoire longue (32+ caractères) et ne plus la changer
# après avoir connecté la boîte, sinon il faudra reconnecter Gmail.
GMAIL_TOKEN_ENCRYPTION_KEY=
