# ================================================================
#  CAPELLA CRM — VARIABLES D'ENVIRONNEMENT
# ================================================================
#  Copie ce fichier en « .env.local » (même dossier) et colle
#  les trois valeurs récupérées dans Supabase.
#  Voir GUIDE-JEREMY.md, étape 3.
#
#  ⚠️  .env.local ne doit JAMAIS être partagé ni envoyé sur GitHub.
# ================================================================

# Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Project Settings > API > Project API keys > anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase > Project Settings > API > Project API keys > service_role
# Clé SECRÈTE : elle contourne toutes les protections. Jamais dans le navigateur.
SUPABASE_SERVICE_ROLE_KEY=
