# ================================================================
#  CAPELLA CRM — VARIABLES D'ENVIRONNEMENT
# ================================================================
#  Copie ce fichier en « .env.local » (même dossier) et colle
#  les valeurs récupérées dans les services concernés.
#
#  ⚠️  .env.local ne doit JAMAIS être partagé ni envoyé sur GitHub.
# ================================================================

# Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Project Settings > API > Project API keys > anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase > Project Settings > API > Project API keys > service_role
# Clé SECRÈTE : elle contourne toutes les protections. Jamais dans le navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Secret dédié au webhook Google Form -> CRM.
# Génère une longue valeur aléatoire et mets exactement la même dans Vercel
# et dans les propriétés du script Apps Script sous CAPELLA_FORM_WEBHOOK_SECRET.
FORM_WEBHOOK_SECRET=

# Youtrust — ACD automatique à l'étape « Demande ACD ».
# Clé secrète API : uniquement .env.local + Vercel, jamais GitHub.
YOUTRUST_API_KEY=
# ID du template ACD actif dans le même environnement Youtrust.
YOUTRUST_TEMPLATE_ID=
# production ou sandbox
YOUTRUST_ENV=production
